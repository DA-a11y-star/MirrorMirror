{
  "format": "mirrormirror.preset",
  "version": 1,
  "id": "cyberpunk",
  "name": "Cyberpunk City",
  "description": "A neon city at night, laid out like a model for your hands.",
  "tint": "#ff4fd8",
  "thumbnail": "card.jpg",
  "view": { "yaw": 0, "pitch": 6 },
  "environment": {
    "sky": ["#0a0818", "#3a1560"],
    "fog": ["#1a0c33", 10, 70],
    "ground": "#0d0b1a",
    "sun": { "color": "#b8c4ff", "intensity": 0.9, "position": [-8, 14, -6] },
    "ambient": ["#9b8cff", "#2b1a55", 1.3]
  },
  "objects": {
    "tower-pink": [
      { "shape": "box", "size": [4, 14, 4], "pos": [0, 7, 0], "color": "#15102b",
        "pattern": { "type": "windows", "rows": 14, "cols": 5, "lit": 0.45, "color": "#1c1636", "glow": "#ff5ad8" } },
      { "shape": "box", "size": [4.3, 0.25, 4.3], "pos": [0, 14.1, 0], "color": "#ff5ad8", "emissive": "#ff5ad8" }
    ],
    "tower-cyan": [
      { "shape": "box", "size": [3.4, 10, 3.4], "pos": [0, 5, 0], "color": "#101a2c",
        "pattern": { "type": "windows", "rows": 10, "cols": 4, "lit": 0.4, "color": "#162238", "glow": "#38e8ff" } },
      { "shape": "box", "size": [3.7, 0.22, 3.7], "pos": [0, 10.1, 0], "color": "#38e8ff", "emissive": "#38e8ff" },
      { "shape": "cylinder", "size": [0.12, 3, 0.12], "pos": [0, 11.6, 0], "color": "#38e8ff", "emissive": "#38e8ff" }
    ],
    "slab": [
      { "shape": "box", "size": [6, 6, 3], "pos": [0, 3, 0], "color": "#18122e",
        "pattern": { "type": "windows", "rows": 6, "cols": 8, "lit": 0.35, "color": "#201a3c", "glow": "#ffb347" } }
    ],
    "neon-post": [
      { "shape": "cylinder", "size": [0.12, 3.2, 0.12], "pos": [0, 1.6, 0], "color": "#2a2442" },
      { "shape": "box", "size": [0.9, 0.35, 0.1], "pos": [0, 3.3, 0], "color": "#ff5ad8", "emissive": "#ff5ad8" }
    ],
    "billboard": [
      { "shape": "cylinder", "size": [0.18, 5, 0.18], "pos": [0, 2.5, 0], "color": "#2a2442" },
      { "shape": "box", "size": [3.4, 1.8, 0.2], "pos": [0, 5.6, 0], "color": "#38e8ff", "emissive": "#38e8ff" }
    ]
  },
  "place": [
    { "pos": [0, 0, 0], "clear": 7 },
    { "object": "billboard", "pos": [-9, 0, -14], "yaw": 25, "clear": 3 },
    { "object": "tower-pink", "pos": [0, 0, -30], "scale": 1.6, "clear": 6 }
  ],
  "scatter": [
    { "objects": ["tower-pink", "tower-cyan", "slab", "tower-cyan"], "count": [20, 28], "radius": [11, 58],
      "scale": [0.8, 1.3], "stretch": [0.7, 1.7], "spacing": 8, "snap": 90 },
    { "objects": ["neon-post"], "count": [10, 16], "radius": [6, 26], "spacing": 4 }
  ]
}
